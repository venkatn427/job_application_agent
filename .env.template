# ─────────────────────────────────────────────────────────────────────────────
# Job Application Agent — Environment Variables
# Copy this file to .env and fill in your credentials
# ─────────────────────────────────────────────────────────────────────────────

# ── Optional: AI ──────────────────────────────────────────────────────────────
# Anthropic API key (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Other OpenAI-compatible services use a separate key.
LLM_API_KEY=
# Optional global overrides; task routes live in config/settings.yaml.
# AI_PROVIDER=openai
# AI_MODEL=your-model-id
# AI_BASE_URL=https://api.openai.com/v1

# ── Required: Apify (job scraping) ────────────────────────────────────────────
# Apify API token (get from https://console.apify.com/account/integrations)
# Free tier: 5 USD/month. Paid plans from $49/month.
APIFY_API_TOKEN=apify_api_your-token-here

# ── Optional: Google Drive & Sheets ───────────────────────────────────────────
# Path to Google Service Account JSON key file
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable: Google Drive API, Google Sheets API
GOOGLE_DRIVE_CREDENTIALS_PATH=/path/to/service_account.json

# ID of the Google Drive root folder (from the URL: drive.google.com/drive/folders/<ID>)
# Leave blank to auto-create in My Drive
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ID of Google Sheets spreadsheet for application tracking
# Create a blank Google Sheet and paste its ID from the URL
GOOGLE_SHEETS_SPREADSHEET_ID=

# ── Optional: Email Notifications ─────────────────────────────────────────────
NOTIFY_EMAIL_TO=your-email@gmail.com
NOTIFY_EMAIL_FROM=your-sender@gmail.com
# For Gmail: use an App Password (not your main password)
# https://myaccount.google.com/apppasswords
NOTIFY_EMAIL_PASSWORD=your-app-password-here
# SMTP settings (defaults work for Gmail)
# NOTIFY_SMTP_HOST=smtp.gmail.com
# NOTIFY_SMTP_PORT=587

# ── Optional: Slack Notifications ────────────────────────────────────────────
# Create an Incoming Webhook at: https://api.slack.com/apps
NOTIFY_SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Optional: Discord Notifications ──────────────────────────────────────────
NOTIFY_DISCORD_WEBHOOK=https://discord.com/api/webhooks/XXX/YYY

# ── Optional: USAJobs (US federal government roles) ───────────────────────────
# Register at: https://developer.usajobs.gov/
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=your-email@example.com

# ── Pipeline tweaks ───────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Path to settings.yaml (default: ./config/settings.yaml)
PIPELINE_SETTINGS_PATH=config/settings.yaml
